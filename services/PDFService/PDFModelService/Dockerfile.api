FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-devel

# Build argument for OpenShift mode
# When true: assumes build context is repo root
# When false (default): assumes build context is services/PDFService/PDFModelService/
ARG OPENSHIFT_MODE=false

# Install system dependencies
RUN apt-get update \
    && apt-get install -y \
        curl \
        git \
        procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy everything to temp location first
COPY . /build/

WORKDIR /app

# Install shared package (only for OpenShift mode, when building from root)
RUN if [ "$OPENSHIFT_MODE" = "true" ]; then \
      if [ -d /build/shared ]; then \
        cp -r /build/shared /shared && pip install /shared; \
      fi; \
    fi

# Install Python dependencies - only API requirements
RUN if [ "$OPENSHIFT_MODE" = "true" ]; then \
      cp /build/services/PDFService/PDFModelService/requirements.api.txt /app/; \
    else \
      cp /build/requirements.api.txt /app/; \
    fi
RUN pip install -r requirements.api.txt

# Copy application files
RUN if [ "$OPENSHIFT_MODE" = "true" ]; then \
      cp /build/services/PDFService/PDFModelService/main.py /app/ && \
      cp /build/services/PDFService/PDFModelService/tasks.py /app/; \
    else \
      cp /build/main.py /app/ && \
      cp /build/tasks.py /app/; \
    fi

# Clean up build directory
RUN rm -rf /build

# Create directory for temporary files
RUN mkdir -p /tmp/pdf_conversions

EXPOSE 8004

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8004"]